generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  steamId      String   @unique
  displayName  String
  avatarUrl    String
  balance      Int      @default(0)
  vipRole      String   @default("PLAYER")
  vipExpiresAt String?
  tradeUrl     String?
  // Leaderboard uchun statistika — hozircha qo'lda/admin orqali yangilanadi,
  // kelajakda real CS2 serverdan (SourceMod plugin -> API) avtomatik keladi
  kills        Int      @default(0)
  deaths       Int      @default(0)
  score        Int      @default(0)
  level        Int      @default(1)
  headshotPct  Float    @default(0)
  winRate      Float    @default(0)
  createdAt    DateTime @default(now())
  sellingListings SkinListing[]    @relation("SellerListings")
  purchases       SkinTransaction[] @relation("BuyerTransactions")
  sales           SkinTransaction[] @relation("SellerTransactions")
  ban             BanRecord?
}

model BanRecord {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  bannedBy  String   @default("Admin")
  expiresAt DateTime? // null = doimiy (permanent) ban
  createdAt DateTime @default(now())
}

model GameServer {
  id            String   @id
  name          String
  ip            String
  mode          String
  map           String
  onlinePlayers Int      @default(0)
  maxPlayers    Int      @default(20)
  ping          Int      @default(5)
  badge         String
}

model RequestTicket {
  id        Int      @id @default(autoincrement())
  name      String
  telegram  String
  type      String
  message   String
  createdAt DateTime @default(now())
}

// -------------------------------------------------------
// SKIN MARKETPLACE (P2P, fixed-price, bot-escrow model)
// -------------------------------------------------------

model SkinListing {
  id             Int      @id @default(autoincrement())
  sellerId       Int
  seller         User     @relation("SellerListings", fields: [sellerId], references: [id])
  assetId        String   // Steam inventory asset id (identifies the exact item instance)
  classId        String
  instanceId     String
  marketHashName String
  weaponType     String?  // Steam'ning o'z type maydoni: "Covert Rifle", "Extraordinary Knife" va h.k. — rarity filtri uchun
  inspectLink    String?  // Steam'ning "self-encoded" inspect linki — float/paint seed'ni istalgan vaqt mahalliy dekodlash uchun
  iconUrl        String
  price          Int      // in UZS (butun so'm)
  status         String   @default("ACTIVE") // ACTIVE | PENDING | SOLD | CANCELLED | BOT_STOCK (instant-sell orqali botga o'tgan)
  createdAt      DateTime @default(now())
  transaction    SkinTransaction?
}

model SkinTransaction {
  id                      Int      @id @default(autoincrement())
  listingId               Int      @unique
  listing                 SkinListing @relation(fields: [listingId], references: [id])
  buyerId                 Int
  buyer                   User     @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId                Int
  seller                  User     @relation("SellerTransactions", fields: [sellerId], references: [id])
  price                   Int
  // AWAITING_SELLER_TRADE -> BOT_HOLDING_ITEM -> AWAITING_BUYER_TRADE -> COMPLETED
  // (yoki ESCROW_SELLER / ESCROW_BUYER -> Steam escrow tugagach davom etadi)
  // (yoki -> FAILED / CANCELLED istalgan bosqichda)
  status                  String   @default("AWAITING_SELLER_TRADE")
  botToSellerTradeOfferId String?
  botToBuyerTradeOfferId  String?
  escrowEndsAt            DateTime?
  failReason              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// -------------------------------------------------------
// INPAY TO'LOV BUYURTMALARI
// -------------------------------------------------------

model PaymentOrder {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique  // inPAY order_id (hex string)
  steamId       String            // User.steamId (FK sifatida emas — user yo'q holda ham saqlansin)
  amount        Int               // UZS
  status        String   @default("pending") // pending | success | failed | cancelled
  paymentMethod String?           // click | payme | cardsystem | null (foydalanuvchi tanlagan)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
